[sub_resource type="Shader" id="Shader_grass_background"]
code = "shader_type canvas_item;

void fragment() {
	vec3 pixel = texture(TEXTURE, UV).rgb;
	const vec3 grass_background = vec3(62.0, 137.0, 72.0) / 255.0;
	if (distance(pixel, grass_background) < 0.006) {
		COLOR.a = 0.0;
	}
}
