  "behavior_notes": [
    {
      "change": "InventoryStore.Add returns the unaccepted amount for invalid/rejected item categories instead of reporting success with zero.",
      "reason": "Make remainder semantics consistent with the inventory interface; covered by core checks."
    },
    {
      "change": "The existing unbound WaterState node now references its C# script and explicit enum state ID.",
      "reason": "Complete the scene binding during migration; the player normally uses ToolState for watering."
    },
    {
      "change": "The TileSet merge command carries physics and terrain definitions and remaps terrain IDs instead of merging atlas sources into an empty TileSet.",
      "reason": "The original helper generated out-of-range terrain errors; the C# port must preserve the referenced terrain configuration."
    }
  ]
