extends SceneTree
## Preserve authored foliage: identical diagnostic frames, GPU shear only.
const SOURCE: String = "res://assets/Outdoor decoration/Outdoor_Decor.png"
const COORDS: Array[Vector2i] = [
	# Original four grass types keep their stable indices.
	Vector2i(6, 2), Vector2i(6, 3), Vector2i(7, 3), Vector2i(8, 3),
	# Ground flowers, grass sprigs and upright flower buds.
	Vector2i(0, 0), Vector2i(1, 0), Vector2i(2, 0), Vector2i(3, 0), Vector2i(4, 0), Vector2i(5, 0),
	Vector2i(0, 1), Vector2i(1, 1), Vector2i(2, 1), Vector2i(3, 1), Vector2i(4, 1), Vector2i(5, 1),
	Vector2i(6, 1), Vector2i(7, 1), Vector2i(8, 1),
	Vector2i(0, 2), Vector2i(1, 2), Vector2i(2, 2), Vector2i(3, 2), Vector2i(4, 2), Vector2i(5, 2),
	# Single-tile water plants, lilies and reeds.
	Vector2i(3, 3), Vector2i(4, 3), Vector2i(5, 3), Vector2i(3, 4), Vector2i(4, 5),
	Vector2i(8, 7), Vector2i(6, 8), Vector2i(7, 8), Vector2i(8, 8), Vector2i(8, 9),
	Vector2i(6, 15), Vector2i(6, 16),
	Vector2i(5, 17), Vector2i(6, 17), Vector2i(7, 17), Vector2i(8, 17),
	Vector2i(5, 18), Vector2i(6, 18), Vector2i(7, 18), Vector2i(8, 18),
	Vector2i(5, 19), Vector2i(6, 19), Vector2i(7, 19), Vector2i(8, 19),
	Vector2i(4, 20), Vector2i(5, 20), Vector2i(6, 20), Vector2i(7, 20), Vector2i(8, 20),
	Vector2i(4, 21), Vector2i(4, 22), Vector2i(4, 23), Vector2i(4, 24), Vector2i(4, 25),
	# Rounded bush and four leafy shrubs; the rock at (4, 9) stays static.
	Vector2i(5, 5), Vector2i(3, 9), Vector2i(5, 9), Vector2i(6, 9), Vector2i(7, 9),
	# All ten mushroom variants, including the small caps and clusters.
	Vector2i(7, 2), Vector2i(8, 2), Vector2i(0, 3), Vector2i(1, 3), Vector2i(2, 3),
	Vector2i(0, 4), Vector2i(1, 4), Vector2i(2, 4), Vector2i(2, 5), Vector2i(2, 6),
	# Six tall flower tiles. Read their true 16x32 / 32x32 regions below.
	Vector2i(5, 21), Vector2i(7, 21), Vector2i(8, 21),
	Vector2i(5, 23), Vector2i(7, 23), Vector2i(8, 23),
]

func _initialize() -> void:
	var source: Image = Image.load_from_file(ProjectSettings.globalize_path(SOURCE))
	source.convert(Image.FORMAT_RGBA8)
	# Inspect the scene without entering the tree or binding a save profile.
	var scene: Node2D = load("res://world/main_world.tscn").instantiate() as Node2D
	var layer: TileMapLayer = scene.get_node("TinyDecor")
	var tiles: TileSetAtlasSource = layer.tile_set.get_source(4) as TileSetAtlasSource
	var atlas: Image = Image.create_empty(256, COORDS.size() * 32, false, Image.FORMAT_RGBA8)
	var types: Array[Dictionary] = []
	for row: int in range(COORDS.size()):
		var coords: Vector2i = COORDS[row]
		var region: Rect2i = tiles.get_tile_texture_region(coords)
		var tile: Image = source.get_region(region)
		var used: Rect2i = tile.get_used_rect()
		for frame: int in range(8):
			atlas.blit_rect(tile, Rect2i(Vector2i.ZERO, region.size), Vector2i(frame * 32, row * 32))
		types.append({"id": "farm_grass_%d_%d" % [coords.x, coords.y], "path": SOURCE, "coords": [coords.x, coords.y],
			"tilemap_only": row >= 4,
			"root_y": used.end.y, "row": row, "size": [region.size.x, region.size.y], "frames": 8, "fps": 0,
			"diagnostic_stride": 32,
			"source_region": [region.position.x, region.position.y, region.size.x, region.size.y], "opaque_bounds": [used.position.x, used.position.y, used.size.x, used.size.y]})
	atlas.save_png("res://resources/grass/farm_grass_atlas.png")
	var file: FileAccess = FileAccess.open("res://resources/grass/farm_grass_data.gd", FileAccess.WRITE)
	file.store_string("extends RefCounted\n## Generated by build_farm_grass_assets.gd. Original artwork, no guessed strip mapping.\nconst TYPES: Array[Dictionary] = " + JSON.stringify(types, "\t") + "\n")
	file.close()
	print("FARM_GRASS_BAKE=" + JSON.stringify(types))
	scene.free()
	quit()
