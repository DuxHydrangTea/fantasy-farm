extends SceneTree
## Offline, deterministic G0 audit/bake. Never adds MainWorld to the scene tree.
const SOURCE: String = "res://assets/Outdoor decoration/Outdoor_Decor_Animations/Grass_Animations/"
const OUTPUT: String = "res://resources/grass/"
const EVIDENCE: String = "res://docs/grass_gpu_g0_g1_2026-10-24/"

func _initialize() -> void:
	_build.call_deferred()

func _build() -> void:
	var evidence: String = EVIDENCE
	var arguments: PackedStringArray = OS.get_cmdline_user_args()
	if arguments.size() == 2 and arguments[0] == "--evidence-dir":
		evidence = arguments[1].trim_suffix("/") + "/"
	DirAccess.make_dir_recursive_absolute(OUTPUT)
	DirAccess.make_dir_recursive_absolute(evidence)
	var names: Array[String] = []
	for index: int in range(1, 16):
		names.append("Flower_Grass_%d_Anim.png" % index)
	for index: int in range(1, 4):
		names.append("Grass_%d_Anim.png" % index)
	var atlas: Image = Image.create_empty(128, 16 * names.size(), false, Image.FORMAT_RGBA8)
	var types: Array[Dictionary] = []
	for index: int in range(names.size()):
		var path: String = SOURCE + names[index]
		var image: Image = Image.load_from_file(ProjectSettings.globalize_path(path))
		if image == null or image.get_size() != Vector2i(128, 16):
			push_error("Unexpected grass strip: " + path)
			quit(1)
			return
		image.convert(Image.FORMAT_RGBA8)
		atlas.blit_rect(image, Rect2i(0, 0, 128, 16), Vector2i(0, index * 16))
		var bounds: Array = []
		var roots: Array[int] = []
		for frame: int in range(8):
			var used: Rect2i = image.get_region(Rect2i(frame * 16, 0, 16, 16)).get_used_rect()
			bounds.append([used.position.x, used.position.y, used.size.x, used.size.y])
			roots.append(used.end.y)
		var stable: bool = roots.all(func(value: int) -> bool: return value == roots[0])
		if not stable or roots[0] <= 0:
			push_error("Grass strip needs an authored pivot override: " + path)
			quit(1)
			return
		types.append({"id": names[index].get_basename(), "path": path, "row": index,
			"size": [16, 16], "frames": 8, "fps": 8.0, "root_y": roots[0],
			"frame_bounds": bounds, "root_stable": stable})
	if atlas.save_png(OUTPUT + "grass_poc_atlas.png") != OK:
		quit(1)
		return
	var data_file: FileAccess = FileAccess.open(OUTPUT + "grass_catalog_data.gd", FileAccess.WRITE)
	data_file.store_string("extends RefCounted\n## Generated by scripts/grass/build_grass_assets.gd; do not edit manually.\nconst TYPES: Array[Dictionary] = " + JSON.stringify(types, "\t") + "\n")
	data_file.close()
	var report: Dictionary = {"engine": Engine.get_version_info().string, "source_count": types.size(),
		"atlas_size": [128, 16 * names.size()], "source_images_modified": false, "types": types,
		"scenes": [_audit_scene("res://world/main_world.tscn"), _audit_scene("res://world/farm_landscape.tscn")]}
	var report_file: FileAccess = FileAccess.open(evidence + "asset_manifest.json", FileAccess.WRITE)
	report_file.store_string(JSON.stringify(report, "\t"))
	report_file.close()
	print("GRASS_BAKE=" + JSON.stringify({"types": types.size(), "atlas": [128, 288], "scene_audits": report.scenes.size()}))
	quit()

func _audit_scene(path: String) -> Dictionary:
	var packed: PackedScene = load(path) as PackedScene
	var scene: Node = packed.instantiate()
	var layers: Array[Dictionary] = []
	var count: int = _visit(scene, scene, layers)
	scene.free()
	return {"path": path, "authored_nodes": count, "layers": layers, "entered_tree": false}

func _visit(node: Node, root: Node, layers: Array[Dictionary]) -> int:
	var count: int = 1
	if node is TileMapLayer:
		var layer: TileMapLayer = node as TileMapLayer
		var sources: Dictionary = {}
		var tiles: Dictionary = {}
		for cell: Vector2i in layer.get_used_cells():
			var id: int = layer.get_cell_source_id(cell)
			var key: String = str(id)
			var source: TileSetSource = layer.tile_set.get_source(id)
			if not sources.has(key):
				var texture: String = source.texture.resource_path if source is TileSetAtlasSource and source.texture != null else ""
				sources[key] = {"texture": texture, "cells": 0}
			sources[key].cells += 1
			var coords: Vector2i = layer.get_cell_atlas_coords(cell)
			var alternative: int = layer.get_cell_alternative_tile(cell)
			var tile_key: String = "%d:%d,%d:%d" % [id, coords.x, coords.y, alternative]
			if not tiles.has(tile_key):
				var valid_tile: bool = source.has_tile(coords)
				var data: TileData = layer.get_cell_tile_data(cell) if valid_tile else null
				var tile: Dictionary = {"source": id, "atlas_coords": [coords.x, coords.y], "alternative_includes_transform_flags": alternative, "cells": 0, "source_tile_exists": valid_tile}
				if data != null:
					tile["texture_origin"] = [data.texture_origin.x, data.texture_origin.y]
					tile["y_sort_origin"] = data.y_sort_origin
					tile["z_index"] = data.z_index
				if valid_tile and source is TileSetAtlasSource:
					var atlas_source: TileSetAtlasSource = source as TileSetAtlasSource
					var rect: Rect2i = atlas_source.get_tile_texture_region(coords)
					tile["first_frame_region"] = [rect.position.x, rect.position.y, rect.size.x, rect.size.y]
					tile["frames"] = atlas_source.get_tile_animation_frames_count(coords)
					tile["animation_speed"] = atlas_source.get_tile_animation_speed(coords)
				tiles[tile_key] = tile
			tiles[tile_key].cells += 1
		layers.append({"node": String(root.get_path_to(layer)), "cells": layer.get_used_cells().size(),
			"tile_size": [layer.tile_set.tile_size.x, layer.tile_set.tile_size.y] if layer.tile_set != null else [],
			"tileset": layer.tile_set.resource_path if layer.tile_set != null else "", "y_sort": layer.y_sort_enabled,
			"z_index": layer.z_index, "sources": sources, "tiles": tiles,
			"conversion_enabled": false, "mixed_atlas_requires_explicit_allowlist": true})
	for child: Node in node.get_children():
		count += _visit(child, root, layers)
	return count
