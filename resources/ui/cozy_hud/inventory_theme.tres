PrimaryAction/styles/pressed = ExtResource("selected")
PrimaryAction/styles/focus = ExtResource("selected")
HSeparator/constants/separation = 2
HSeparator/styles/separator = SubResource("Horizontal")
VSeparator/constants/separation = 2
VSeparator/styles/separator = SubResource("Vertical")
