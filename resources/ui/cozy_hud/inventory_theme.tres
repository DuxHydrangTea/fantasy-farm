Button/colors/font_pressed_color = Color(0.25, 0.11, 0.06, 1)
Button/colors/font_disabled_color = Color(0.58, 0.47, 0.36, 1)
Button/styles/normal = ExtResource("normal")
Button/styles/hover = ExtResource("selected")
Button/styles/pressed = ExtResource("selected")
Button/styles/focus = ExtResource("selected")
Button/styles/disabled = ExtResource("normal")
PanelContainer/styles/panel = SubResource("Panel")
DetailCard/base_type = &"PanelContainer"
DetailCard/styles/panel = SubResource("Card")
