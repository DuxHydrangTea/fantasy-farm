[gd_resource type="Resource" script_class="CookingRecipe" format=3]
[ext_resource type="Script" path="res://scripts/cooking_recipe.gd" id="script"]
[ext_resource type="Script" path="res://scripts/item_definition.gd" id="item"]
[ext_resource type="Resource" path="res://items/trees/wood.tres" id="wood"]
[ext_resource type="Resource" path="res://items/honey/wild_honey.tres" id="honey"]
[ext_resource type="Resource" path="res://items/boosters/grafting_wax.tres" id="out"]
[resource]
script = ExtResource("script")
recipe_id = &"grafting_wax"
display_name = "Grafting Wax"
ingredients = Array[ExtResource("item")]([ExtResource("wood"), ExtResource("honey")])
amounts = Array[int]([5, 1])
output = ExtResource("out")
cook_seconds = 60.0
coin_cost = 1000
