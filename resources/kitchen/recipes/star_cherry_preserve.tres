[gd_resource type="Resource" script_class="CookingRecipe" format=3]
[ext_resource type="Script" path="res://scripts/cooking_recipe.gd" id="script"]
[ext_resource type="Script" path="res://scripts/item_definition.gd" id="item"]
[ext_resource type="Resource" path="res://items/trees/cherry_star.tres" id="fruit"]
[ext_resource type="Resource" path="res://items/honey/wild_honey.tres" id="honey"]
[ext_resource type="Resource" path="res://items/cooked/star_cherry_preserve.tres" id="out"]
[resource]
script = ExtResource("script")
recipe_id = &"star_cherry_preserve"
display_name = "Star Cherry Preserve"
ingredients = Array[ExtResource("item")]([ExtResource("fruit"), ExtResource("honey")])
amounts = Array[int]([2, 1])
output = ExtResource("out")
cook_seconds = 14400.0
