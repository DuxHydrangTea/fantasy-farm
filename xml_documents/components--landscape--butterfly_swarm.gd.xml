	<members>
		<member name="population" type="int" setter="" getter="" default="48">
			Số cá thể tạo khi khởi tạo.
		</member>
		<member name="roam_bounds" type="Rect2" setter="" getter="" default="Rect2(24, 32, 2496, 1640)">
			Giới hạn vùng bay.
		</member>
		<member name="garden_bounds" type="Rect2" setter="" getter="" default="Rect2(1432, 296, 368, 256)">
