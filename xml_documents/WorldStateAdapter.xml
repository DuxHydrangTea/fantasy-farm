		<method name="preflight">
			<return type="Dictionary" />
			<param index="0" name="data" type="Dictionary" />
			<description>
				Kiểm tra schema và các liên kết với scene trước khi thay đổi thế giới. Bao gồm trạng thái giao dịch, các thực thể và vị trí cần tồn tại trong map. Trả snapshot đã kiểm tra hoặc dictionary lỗi.
			</description>
		</method>
		<method name="restore">
			<return type="Dictionary" />
			<param index="0" name="data" type="Dictionary" />
			<param index="1" name="now" type="float" />
			<description>
				Khôi phục checkpoint rồi tiến công nhân đồng bộ đến thời điểm yêu cầu. Không mô phỏng lùi trước thời điểm lưu.
			</description>
		</method>
		<method name="restore_async">
			<return type="Dictionary" />
			<param index="0" name="data" type="Dictionary" />
