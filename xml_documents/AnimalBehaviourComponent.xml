<?xml version="1.0" encoding="UTF-8" ?>
<class name="AnimalBehaviourComponent" inherits="Node" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
	<brief_description>
		Máy trạng thái quyết định hành vi của một vật nuôi.
	</brief_description>
	<description>
		Wander quản lý đích, Movement xử lý vật lý, Foraging tìm và dùng máng. Các chuyển động nằm xuống và đứng dậy chờ hoạt ảnh hoàn thành trước khi chuyển trạng thái. Tập trung hoặc giữ để chăm sóc tạm dừng hành vi.
	</description>
	<tutorials>
	</tutorials>
	<methods>
		<method name="_ready">
			<return type="void" />
			<description>
			</description>
		</method>
		<method name="configure">
			<return type="void" />
			<param index="0" name="data" type="AnimalDefinition" />
			<description>
				Gắn cấu hình, tiếp quản bước vật lý của Wander và chọn hoạt ảnh hỗ trợ. Trạng thái bắt đầu là IDLE và sẵn sàng đưa ra quyết định đầu tiên.
			</description>
		</method>
		<method name="_physics_process">
			<return type="void" />
			<param index="0" name="delta" type="float" />
			<description>
			</description>
		</method>
		<method name="set_focused">
			<return type="void" />
			<param index="0" name="value" type="bool" />
			<description>
				Bật hoặc tắt trạng thái người chơi đang tập trung vào con vật. Khi bật, hủy tìm máng và chuyển về đứng yên.
			</description>
		</method>
		<method name="hold_for_care">
			<return type="void" />
			<param index="0" name="owner" type="Node" />
			<param index="1" name="is_active" type="Callable" />
			<description>
				Giữ con vật đứng yên trong khi một owner thực hiện chăm sóc. Owner được giữ bằng weak reference và predicate xác định giữ còn hiệu lực.
			</description>
		</method>
		<method name="release_care_hold">
			<return type="void" />
			<param index="0" name="owner" type="Node" />
			<description>
				Bỏ lượt giữ chăm sóc của owner.
			</description>
		</method>
		<method name="_has_care_hold">
			<return type="bool" />
			<description>
			</description>
		</method>
		<method name="request_behaviour">
			<return type="bool" />
			<param index="0" name="action" type="StringName" />
			<description>
				Yêu cầu hành vi khi con vật đang đứng và không bị giữ hoặc tập trung. Con vật đang nằm cần gọi [method wake] trước. Trả false nếu hành động không được hỗ trợ hoặc không thể bắt đầu.
			</description>
		</method>
		<method name="wake">
			<return type="bool" />
			<description>
				Đánh thức từ trạng thái nghỉ hoặc ngủ; trên đất chờ hoạt ảnh đứng dậy. Trả false nếu hiện không nghỉ hoặc ngủ.
			</description>
		</method>
