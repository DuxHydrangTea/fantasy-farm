			<param index="1" name="timestamp" type="float" />
			<description>
			</description>
		</method>
		<method name="crop_is_pollinated">
			<return type="bool" />
			<param index="0" name="point" type="Vector2" />
			<description>
				Kiểm tra điểm cây được thụ phấn theo thời tiết đã xử lý gần nhất.
			</description>
		</method>
		<method name="_point_is_pollinated">
			<return type="bool" />
			<param index="0" name="point" type="Vector2" />
			<param index="1" name="radius_squared" type="float" />
			<description>
			</description>
		</method>
		<method name="snap_position">
			<return type="Vector2" />
			<param index="0" name="point" type="Vector2" />
			<description>
				Làm tròn vị trí toàn cục về tâm ô farmland.
			</description>
		</method>
		<method name="placement_error">
			<return type="String" />
			<param index="0" name="point" type="Vector2" />
			<param index="1" name="columns" type="int" default="-1" />
			<param index="2" name="restoring" type="bool" default="false" />
			<param index="3" name="legacy_garden" type="bool" default="false" />
			<description>
				Kiểm tra đất mở, nền, vật cản và quy tắc vườn cho vị trí đặt tổ. Trả chuỗi rỗng nếu hợp lệ; chế độ restoring dùng các ngoại lệ va chạm khi tải.
			</description>
		</method>
		<method name="place">
			<return type="Dictionary" />
			<param index="0" name="point" type="Vector2" />
			<param index="1" name="player" type="FarmPlayer" />
			<param index="2" name="slot" type="int" />
			<description>
				Kiểm tra vị trí và ô túi, đồng bộ thời gian rồi đặt tổ và tiêu một vật phẩm. Thành công trả actor tổ; thất bại trả thông báo lỗi.
			</description>
		</method>
		<method name="create_hive">
			<return type="Beehive" />
			<param index="0" name="point" type="Vector2" />
			<param index="1" name="id" type="StringName" />
			<description>
				Tạo tổ và đăng ký ô chiếm; nơi gọi chịu trách nhiệm kiểm tra trước vị trí.
			</description>
		</method>
		<method name="begin_restore">
			<return type="void" />
			<description>
				Ngừng mô phỏng, xóa cache nguồn và loại các tổ hiện tại trước khi khôi phục.
			</description>
		</method>
		<method name="restore">
			<return type="void" />
			<param index="0" name="rows" type="Array" />
			<param index="1" name="saved_at" type="float" />
			<param index="2" name="now" type="float" />
			<description>
				Dựng tổ từ bản ghi đã kiểm tra, rồi tiến từ thời điểm lưu đến now.
			</description>
		</method>
	</methods>
