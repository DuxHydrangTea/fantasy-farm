		<method name="advance">
			<return type="void" />
			<param index="0" name="timestamp" type="float" />
			<description>
				Tiến cây và tổ đến timestamp, cập nhật nguồn hoa, mật và giảm thời gian chín. Không tiến lùi và bỏ qua lời gọi lồng nhau hoặc khi đang tải.
			</description>
		</method>
		<method name="_update_boosted">
			<return type="void" />
