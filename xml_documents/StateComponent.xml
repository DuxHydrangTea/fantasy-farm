			</description>
		</method>
		<method name="cancel_input">
			<return type="void" />
			<description>
				Xóa yêu cầu, hướng cảm ứng và hủy đường đi hiện tại.
			</description>
		</method>
		<method name="get_selected_tool_action">
			<return type="StringName" />
